# Optional. Keys are stored in the system keychain (see README → "Where keys are stored").
# Use this only to import keys from an older setup that kept them in files elsewhere:
# set the paths, run `python -m dz` once, and the files are copied into the keychain.

# MOODLE_URL=https://moodle.your-university.edu
# MOODLE_TOKEN_FILE=~/.dz/moodle-token
# CLASSROOM_URL_FILE=~/.dz/classroom-url
# CLASSROOM_CLIENT_FILE=~/.dz/google-client.json
# CLASSROOM_TOKEN_FILE=~/.dz/google-token.json
# TG_CONFIG_FILE=~/.dz/telegram-api.json
# TG_SESSION_FILE=~/.dz/telegram.session
